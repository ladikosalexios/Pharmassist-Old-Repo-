**/__pycache__/
.env
.env.prod
backend/.env
# Claude Code: commit only team-shared config. Everything else in .claude/ stays local:
# settings.local.json, launch.json, worktrees/, session locks and transcripts, and agent
# presets other than the shared ones listed (personal presets live there). Other shared
# content (e.g. a commands/ directory) needs its own `!` line here. Ignore the
# directory's contents, never the directory itself: `.claude/` would hide new hook/skill
# files from git status and the Stop hook, and make `git add` of tracked config exit 1.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/agents/
.claude/agents/*
!.claude/agents/code-reviewer.md
# Claude Code state in a session started from a subdirectory
*/**/.claude/
# Do NOT ignore CLAUDE.md. On a case-insensitive filesystem (macOS default) a
# `CLAUDE.MD` entry here also matches `CLAUDE.md`, and AGENTS.md links to it.
# Ignoring it once gave every fresh clone a dangling symlink and no project
# instructions at all (cloud/CI sessions ran blind).
.vscode
*.code-workspace
# macOS Finder junk (matches at any depth)
.DS_Store
# Local release-readiness audit reports (not for the repo)
docs/release-readiness-audit-*.md

# HMVO IQE qualification run artifacts (local only — logs + scratch manifests)
backend/scripts/iqe_dryrun_*.jsonl
backend/scripts/iqe_oneshot.json
backend/scripts/iqe_invalid.json

# local-only demo deploy secrets (never commit)
deploy/aws/.demo-secrets

# Per-worktree verification dependencies and generated caches
backend/.venv/
backend/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
**/*.tsbuildinfo
# Personal Codex services/agent presets are not portable team configuration.
.codex/config.toml
.codex/agents/
.codex/*.local.*
