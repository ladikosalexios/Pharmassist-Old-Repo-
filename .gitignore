**/__pycache__/
.env
.env.prod
backend/.env
# Per-user / runtime Claude Code state — keep ignored
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.claude/projects/
# Team-shared Claude Code config — commit these
!.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**
# Do NOT ignore CLAUDE.md. On a case-insensitive filesystem (macOS default) a
# `CLAUDE.MD` entry here also matches `CLAUDE.md`, and AGENTS.md is a tracked
# symlink to it — so ignoring it gave every fresh clone a dangling symlink and
# no project instructions at all (cloud/CI sessions ran blind).
.vscode
*.code-workspace
# macOS Finder junk (matches at any depth)
.DS_Store
# Local release-readiness audit reports (not for the repo)
docs/release-readiness-audit-*.md

# Claude session state (per-session locks, transcripts)
.claude/

# HMVO IQE qualification run artifacts (local only — logs + scratch manifests)
backend/scripts/iqe_dryrun_*.jsonl
backend/scripts/iqe_oneshot.json
backend/scripts/iqe_invalid.json

# local-only demo deploy secrets (never commit)
deploy/aws/.demo-secrets

# Per-worktree verification dependencies and generated caches
backend/.venv/
backend/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
**/*.tsbuildinfo
# Personal Codex services/agent presets are not portable team configuration.
.codex/config.toml
.codex/agents/
.codex/*.local.*
