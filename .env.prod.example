# PharmAssist pilot — production env file.
# Copy to .env.prod (gitignored) and fill in real values, then:
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
#
# compose.prod.yaml refers to every variable below with ${VAR:?...}, so a
# missing or empty value aborts the boot with a clear error instead of starting
# an insecure stack.

# ── Secrets (required) ───────────────────────────────────────────────────────
# JWT / session-cookie signing key.        openssl rand -hex 32
SECRET_KEY=
# AES-256-GCM key for credential encryption at rest (base64 of 32 bytes).
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Postgres superuser password for the pilot DB (used in DATABASE_URL too).
POSTGRES_PASSWORD=

# ── ΗΔΥΚΑ Pharmapi credentials (required) ────────────────────────────────────
# The app runs with PHARMAPI_MOCK=true, so these are NOT used for live calls at
# runtime — BUT `python -m scripts.seed` authenticates against live Pharmapi to
# build the demo pharmacy/pharmacist, so they must be real to seed. See the
# runbook (§Seed) for the 24h ΗΔΥΚΑ session requirement.
PHARMAPI_USERNAME=
PHARMAPI_PASSWORD=
PHARMAPI_API_KEY=

# ── Networking / TLS (optional) ──────────────────────────────────────────────
# Public DNS name for auto-HTTPS. Leave unset (defaults to localhost) for a
# local-cert smoke test on a dev box.
# PILOT_DOMAIN=pilot.example.gr
# Set to "tls internal" for a Tailscale-only deployment (self-signed CA). Leave
# unset for public auto-HTTPS.
# CADDY_TLS=tls internal

# CORS is pinned to https://<PILOT_DOMAIN> automatically (compose.prod.yaml).
# Override only if the API is reached from a different or additional origin
# (comma-separated, no spaces).
# CORS_ALLOW_ORIGINS=https://pilot.example.gr
