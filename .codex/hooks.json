{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) || exit 2; bash \"$root/.codex/hooks/format-on-edit.sh\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit|apply_patch"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) || exit 2; bash \"$root/.codex/hooks/typecheck-on-stop.sh\""
          }
        ]
      }
    ]
  }
}
