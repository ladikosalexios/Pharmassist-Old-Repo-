# PharmAssist test stack — env file template.
# Copy to .env.test (gitignored) and fill in real values, then:
#   docker compose -f compose.test.yaml --env-file .env.test up -d --build
#
# compose.test.yaml refers to every required variable below with ${VAR:?...}, so
# a missing or empty value aborts the boot with a clear error.

# ── App secrets (required) ───────────────────────────────────────────────────
# JWT / session-cookie signing key.          openssl rand -hex 32
SECRET_KEY=
# AES-256-GCM key for credential encryption at rest (base64 of 32 bytes).
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Postgres password for the test stack's DB (separate volume from the pilot).
POSTGRES_PASSWORD=

# ── ΗΔΥΚΑ Pharmapi (testeps) — required ──────────────────────────────────────
# A real working ΗΔΥΚΑ test account. The test stack runs PHARMAPI_MOCK=false, so
# these are used both by `python -m scripts.seed` AND for every runtime call.
# The 24h session rule applies — see docs/test-env-runbook.md if /user/me 401s.
PHARMAPI_USERNAME=
PHARMAPI_PASSWORD=
PHARMAPI_API_KEY=
# Override only if you need to point at a non-default testeps URL.
# PHARMAPI_BASE=https://testeps.e-prescription.gr/pharmapiv2

# ── HMVS (NMVO ITE) — required ───────────────────────────────────────────────
# PharmAssist-IQE-1 equipment credentials (our own equipment registered with
# the NMVO, NOT the shared Test-Book pair). Sourced from SSM in deploys.
#
# URL CAVEAT — confirmed against backend/app/config.py:140-141 + services/
# hmvs.py:192. The token URL is built as `{HMVS_IDENTITY_URL}/identity/connect/
# token`, so HMVS_IDENTITY_URL must NOT carry the `/identity` suffix. The
# verification URL appends `/product/gs1/{gtin}/...`, so the `/verification`
# suffix BELONGS in HMVS_VERIFICATION_URL.
HMVS_CLIENT_ID=
HMVS_CLIENT_SECRET=
# HMVS_IDENTITY_URL=https://api-ite.nmvo.eu
# HMVS_VERIFICATION_URL=https://api-ite.nmvo.eu/verification

# ── Observability (optional) ─────────────────────────────────────────────────
# Sentry — leave SENTRY_DSN unset to disable (main.py treats it as a no-op).
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=test

# ── Networking / TLS (optional) ──────────────────────────────────────────────
# PILOT_DOMAIN=test.pharmassist.example
# CADDY_TLS=tls internal
# CORS_ALLOW_ORIGINS=https://test.pharmassist.example

# Host port overrides — only set these if you're running BOTH the mock pilot
# (compose.prod.yaml) AND the test stack on the same host. Docker's port
# binding is exclusive; without this the second `compose up` 'address already
# in use's. The defaults are 80/443 so a test-only box works untouched.
# TEST_HTTP_PORT=8080
# TEST_HTTPS_PORT=8443
