<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ClinicalDocument xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:epsos="urn:epsos-org:ep:medication" xmlns="urn:hl7-org:v3">
    <templateId root="1.3.6.1.4.1.12559.11.10.1.3.1.1.2"/>
    <!-- Βarcode Συνταγής -->
    <id extension="2411223344556" root="1.21"/>
    <author>
        <assignedAuthor>
            <representedOrganization>
                <!-- Το id του φαρμακείου -->
                <id extension="6543" root="1.18.1.1" />
            </representedOrganization>
        </assignedAuthor>
    </author>
    <component>
        <structuredBody>
            <component>
                <section>
                    <text>
                        <!-- Λίστα Φαρμάκων -->
                        <list>
                            <!-- Βarcode 1ου Φαρμάκου -->
                            <item ID="med_barcode_1">2802676702022</item>
                            <!-- Βarcode 2ου Φαρμάκου -->
                            <item ID="med_barcode_2">2802009201024</item>
                        </list>
                    </text>
                    <entry>
                        <act>
                            <!-- Ιd Περίπτωσης εκτέλεσης -->
                            <!-- 0: ΟΧΙ ΠΛΗΡΩΣ ΕΚΤΕΛΕΣΜΕΝΗ ΣΥΝΤΑΓΗ | 1: ΟΛΑ ΤΑ ΦΑΡΜΑΚΑ -->
                            <!-- 2: ΟΧΙ ΟΛΑ ΤΑ ΦΑΡΜΑΚΑ, ΕΠΙΘΥΜΙΑ ΑΣΘΕΝΗ |3: ΟΧΙ ΟΛΑ ΤΑ ΦΑΡΜΑΚΑ, ΑΣΥΜΦΩΝΙΑ ΔΟΣΟΛΟΓΙΑΣ ΚΑΙ ΠΟΣΟΤΗΤΑΣ -->
                            <id extension="1" root="2.10.7" />
                            <!-- Γνωμάτευση -->
                            <id extension="1" root="1.1.23" />
                        </act>
                    </entry>
                    <!-- Λίστα Φαρμάκων -->
                    <!-- Η Λίστα Φαρμάκων αποτελείται από 2 Δεδομένα (1 ποσότητες για το δεύτερο φάρμακο και 1 ποσότητα για το πρώτο) -->
                    <!-- 1ο Δεδομένο της Λίστας των Φαρμάκων -->
                    <!-- Εκτέλεση με Ταινία Γνησιότητας -->
                    <entry>
                        <supply classCode="SPLY" moodCode="ENV">
                            <!-- id Θεραπείας -->
                            <!-- To id της γραμμής συνταγής της ποσότητας του φαρμάκου που εκτελείται αντιστοιχεί στο id της γραμμής συνταγής του συνταγογραφημένου φαρμάκου-->
                            <id extension="22033332" root="1.21.1" />
                            <product>
                                <manufacturedProduct classCode="MANU">
                                    <manufacturedMaterial>
                                        <code>
                                            <originalText>
                                                <!-- Αναφορά στο πρώτο barcode Φαρμάκου -->
                                                <reference value="#med_barcode_1" />
                                            </originalText>
                                        </code>
                                        <epsos:asContent classCode="CONT">
                                            <epsos:containerPackagedMedicine classCode="CONT" determinerCode="KIND">
                                                <!-- QR Serial Number ή Ταινία Γνησιότητας -->
                                                <epsos:lotNumberText>230100011999</epsos:lotNumberText>
                                            </epsos:containerPackagedMedicine>
                                        </epsos:asContent>
                                    </manufacturedMaterial>
                                </manufacturedProduct>
                            </product>
                            <entryRelationship typeCode="SPRT">
                                <act classCode="ACT" moodCode="EVN">
                                    <!-- Συγκατάθεση Ασθενή - 0 : ΌΧΙ | 1 : ΝΑΙ -->
                                    <id extension="1" root="2.10.6" />
                                    <!-- Τιμή Φαρμάκου -->
                                    <id extension="10" root="2.10.9" />
                                    <!-- Τιμή λιανικής πώλησης Φαρμάκου  -->
                                    <id extension="10" root="2.10.11" />
                                    <!-- Τιμή αναφοράς Φαρμάκου -->
                                    <id extension="25" root="2.10.10" />
                                    <!-- Διπλή ακύρωση ταινίας γνησιότητας -->
                                    <id extension="0" root="2.10.13" />
                                    <!-- Ένδειξη αν η εκτέλεση γίνεται με ακύρωση Ταινίας γνησιότητας ΕΟΦ (Τιμή 0) ή με QR code HMVS (Τιμή 1) -->
                                    <id extension="0" root="2.10.14" />
                                    <!-- Το section εμφανίζεται μόνο για φάρμακα που χαρακτηρίζονται ως εισαγωγές ΙΦΕΤ -->
                                    <!-- Εμπορική ονομασία φαρμάκου εισαγωγής ΙΦΕΤ -->
                                    <id extension="commercial name" root="1.4.28" />
                                    <!-- Μονάδα δόσης φαρμάκου εισαγωγής ΙΦΕΤ -->
                                    <id extension="dose unit" root="1.4.29" />
                                    <!-- Φαρμ. μορφή φαρμάκου εισαγωγής ΙΦΕΤ -->
                                    <id extension="pharm form code" root="1.4.30" />
                                    <!-- Περιεκτικότητα φαρμάκου εισαγωγής ΙΦΕΤ -->
                                    <id extension="pharm content" root="1.4.31" />
                                    <!-- Συσκευασία φαρμάκου εισαγωγής ΙΦΕΤ -->
                                    <id extension="package" root="1.4.32" />
                                    <!-- Τιμή Μονάδος φαρμάκου εισαγωγής ΙΦΕΤ -->
                                    <id extension="10.0" root="1.4.33" />
                                </act>
                            </entryRelationship>
                        </supply>
                    </entry>
                    <!-- 2ο Δεδομένο της Λίστας των Φαρμάκων -->
                    <!-- Εκτέλεση με νέα λειτουργικότητα QR code -->
                    <entry>
                        <supply classCode="SPLY" moodCode="ENV">
                            <!-- id Θεραπείας -->
                            <!-- To id της γραμμής συνταγής της ποσότητας του φαρμάκου που εκτελείται αντιστοιχεί στο id της γραμμής συνταγής του συνταγογραφημένου φαρμάκου-->
                            <id extension="22033333" root="1.21.1" />
                            <product>
                                <manufacturedProduct classCode="MANU">
                                    <manufacturedMaterial>
                                        <code>
                                            <originalText>
                                                <!-- Αναφορά στο πρώτο barcode Φαρμάκου -->
                                                <reference value="#med_barcode_2" />
                                            </originalText>
                                        </code>
                                        <epsos:asContent classCode="CONT">
                                            <epsos:containerPackagedMedicine classCode="CONT" determinerCode="KIND">
                                                <!-- QR Serial Number ή Ταινία Γνησιότητας -->
                                                <epsos:lotNumberText>123BDF2123</epsos:lotNumberText>
                                            </epsos:containerPackagedMedicine>
                                        </epsos:asContent>
                                    </manufacturedMaterial>
                                </manufacturedProduct>
                            </product>
                            <entryRelationship typeCode="SPRT">
                                <act classCode="ACT" moodCode="EVN">
                                    <!-- Συγκατάθεση Ασθενή - 0 : ΌΧΙ | 1 : ΝΑΙ -->
                                    <id extension="1" root="2.10.6" />
                                    <!-- Τιμή Φαρμάκου -->
                                    <id extension="10" root="2.10.9" />
                                    <!-- Τιμή λιανικής πώλησης Φαρμάκου  -->
                                    <id extension="10" root="2.10.11" />
                                    <!-- Τιμή αναφοράς Φαρμάκου -->
                                    <id extension="25" root="2.10.10" />
                                    <!-- Διπλή ακύρωση ταινίας γνησιότητας -->
                                    <id extension="0" root="2.10.13" />
                                    <!-- Ένδειξη αν η εκτέλεση γίνεται με ακύρωση Ταινίας γνησιότητας ΕΟΦ (Τιμή 0) ή με QR code HMVS (Τιμή 1) -->
                                    <id extension="1" root="2.10.14" />
                                    <!-- Ένδειξη του product code του QR code. -->
                                    <id extension="123A2123" root="2.10.15" />
                                    <!-- Ένδειξη του Batch No του QR code -->
                                    <id extension="123A2123" root="2.10.16" />
                                    <!-- Ένδειξη του expiry date (string) του QR code. -->
                                    <id extension="241212" root="2.10.17" />
                                    <!-- Ένδειξη αν έγινε χειροκίνητη εισαγωγή του QR code. -->
                                    <id extension="0" root="2.10.18" />
                                    <!-- Ένδειξη του τύπου του κωδικού προϊόντος. -->
                                    <id extension="GS1" root="2.10.19" />
                                </act>
                            </entryRelationship>
                        </supply>
                    </entry>
                </section>
            </component>
        </structuredBody>
    </component>
</ClinicalDocument>
