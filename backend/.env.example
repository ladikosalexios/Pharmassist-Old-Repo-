# Copy this file to backend/.env and fill in real values.
# Anything loaded via app/config.py is read from the environment (or this file).

# --- Required secrets — the app fails to start at boot if any is unset ---
# JWT / session-cookie signing key. Generate one, e.g.: openssl rand -hex 32
SECRET_KEY=
# ΗΔΥΚΑ Pharmapi credentials.
PHARMAPI_USERNAME=
PHARMAPI_PASSWORD=
# Per-app ΗΔΥΚΑ key from your Pharmapi registration email.
PHARMAPI_API_KEY=
# AES-256-GCM key for credential encryption at rest.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Optional — sane defaults live in app/config.py ---
DATABASE_URL=postgresql+asyncpg://pharmassist:pharmassist_dev@localhost:5432/pharmassist
# Pharmapi v2 base URL — this is the *API* host (pharmapiv2), NOT the
# epregen2 pharmacist portal. Default in app/config.py already points to test.
PHARMAPI_BASE=https://testeps.e-prescription.gr/pharmapiv2
# Set true to skip live ΗΔΥΚΑ calls (local dev / tests).
PHARMAPI_MOCK=false
# Proactively ping ΗΔΥΚΑ /user/me on a timer so the 24h session never lapses
# while idle. Off by default (tests/CI must never make live calls); compose
# turns it on. The interval must stay under the 24h window.
PHARMAPI_KEEPALIVE_ENABLED=false
PHARMAPI_KEEPALIVE_INTERVAL_SECONDS=43200

# ── SPC document ingestion (ΠΧΠ/ΦΟΧ) ────────────────────────────────────────
# Automated fetch adapters are OFF by default: a fresh deployment serves only
# manually uploaded documents (POST /admin/spc/upload) until these flip. ΕΟΦ
# is a JSF-scrape adapter — calibrate the form-field constants in
# services/spc_sources/eof.py against the live portal before first enablement.
SPC_FETCH_EOF_ENABLED=false
SPC_FETCH_EMA_ENABLED=false
# Politeness + limits for automated fetching.
SPC_FETCH_MIN_INTERVAL_SECONDS=5
SPC_FETCH_TIMEOUT_SECONDS=30
SPC_FETCH_USER_AGENT=PharmAssist/0.1 (+alexiosl35@gmail.com)
# EMA medicines dataset (xlsx) used to resolve centrally-authorised products —
# the URL drifts, hence a setting. A broken URL degrades to "no EMA docs".
# SPC_EMA_DATASET_URL=https://www.ema.europa.eu/en/documents/report/medicines-output-medicines-report_en.xlsx
SPC_MAX_PDF_BYTES=15000000

# ── LLM seam (Tier-2 AI — T2-2 / D-15: Mistral EU, STANDARD plan) ───────────
# Set true to serve deterministic canned AI outputs and never call the provider
# (local dev / CI / tests / the trial-slice demo). A live Tier-2 box sets this
# false. None of the LLM_* vars below are required at boot — services/llm.py
# checks them at FIRST USE, and only on the live (non-mock) path, so a Tier-1
# deployment boots fine with this whole block absent.
LLM_MOCK=true
# Mistral's EU API host. The OpenAI-compatible chat path is appended by the seam
# (POST {LLM_API_BASE}/v1/chat/completions).
LLM_API_BASE=https://api.mistral.ai
# Mistral STANDARD-plan API key. Secret — NEVER commit it. Empty until Rekas
# accepts the DPA and the key is provisioned (D-15).
LLM_API_KEY=
LLM_MODEL=mistral-large-latest
# Embeddings model — carried now so T2-9 (SPC Q&A / RAG) consumes it unchanged.
LLM_EMBED_MODEL=mistral-embed
# Per-call upstream timeout (seconds); a timeout surfaces as the ai_unavailable
# envelope on AI endpoints.
LLM_TIMEOUT_SECONDS=30

# Set false to allow the session cookie over plain HTTP — local dev only, never false in production.
COOKIE_SECURE=false
# Defaults to true; disable only for unusual proxy setups.
# COOKIE_HTTPONLY=true
# One of: strict, lax, none  (none requires COOKIE_SECURE=true per RFC 6265bis).
# COOKIE_SAMESITE=strict
